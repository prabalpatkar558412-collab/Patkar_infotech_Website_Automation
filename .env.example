# Explicit local demo opt-in. Keep false for live environments.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Server-only Meta App settings > Basic > App secret
META_APP_SECRET=
# Legacy WHATSAPP_APP_SECRET accepted only when META_APP_SECRET is unset.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
# Set true only after reviewing the current official Meta policy and setup
WHATSAPP_POLICY_VERIFIED=false
# Explicit opt-in for automatic/scheduled sends
WHATSAPP_AUTOMATION_ENABLED=false
WORKER_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Explicit public access to real records through server API (all visitors are Admin).
NEXT_PUBLIC_PUBLIC_WORKSPACE=false
